    "dlg-set-pin-txt" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Input PIN code for this DB file (the file will be closed).\nEmpty PIN code will discard the protection.\n\nNOTE: it's a basic protection level and the DB file will not be encrypted.\nThe encryption is supported by plugins."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduzca el código PIN de este archivo de base de datos (el archivo se cerrará).\nEl código PIN vacío apagará la protección.\n\nNOTA: Se trata de un nivel de protección básico y el archivo no se cifrará.\nEl cifrado es compatible con plugins."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите PIN-код для этого файла БД (файл будет закрыт).\nПустой PIN-код снимет защиту.\n\nПРИМЕЧАНИЕ: это базовый уровень защиты, и файл БД не будет зашифрован.\nШифрование поддерживается с помощью плагинов."
          }
        }
      }
    },
